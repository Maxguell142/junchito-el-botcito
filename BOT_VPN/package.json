{
  "name": "bot_vpn",
  "version": "1.0.1",
  "productName": "QUANTUM FX",
  "description": "Panel local de escritorio para QUANTUM FX",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/server/server.js",
    "start:desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "start:fastapi": "python -m uvicorn fastapi_service.main:app --host 127.0.0.1 --port 8000",
    "check:docs": "node scripts/check-obsidian-links.js",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test tests/node/*.test.js",
    "test:python": "python -m pytest tests/python"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.invictus.quantumfx",
    "productName": "QUANTUM FX",
    "asar": true,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**",
      "src/**",
      "public/**",
      "migrations/**",
      "package.json",
      "!public/data/**/*.csv",
      "!tests/**",
      "!documentacion/**",
      "!raw/**",
      "!backups/**",
      "!config.json",
      "!.env",
      "!bot_vpn.sqlite3*",
      "!*.py",
      "!fastapi_service/**",
      "!requirements*.txt",
      "!AGENTS.md",
      "!.agents/**",
      "!.cursorrules"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QuantumFX-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
