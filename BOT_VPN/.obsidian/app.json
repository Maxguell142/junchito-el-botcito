{
  "userIgnoreFilters": [
    "node_modules",
    "node_modules/**",
    ".git",
    ".git/**",
    ".venv",
    ".venv/**",
    "public",
    "public/**",
    "src",
    "src/**",
    "fastapi_service",
    "fastapi_service/**",
    "desktop",
    "desktop/**",
    "tests",
    "tests/**",
    "scripts",
    "scripts/**",
    "migrations",
    "migrations/**",
    "dist",
    "dist/**",
    "dist-desktop",
    "dist-desktop/**",
    "config.json",
    ".env",
    "bot_vpn.sqlite3*",
    ".pytest_cache",
    ".pytest_cache/**",
    "__pycache__",
    "__pycache__/**",
    "backups",
    "backups/**",
    ".system_generated",
    ".system_generated/**"
  ],
  "showUnsupportedFiles": false,
  "newFileLocation": "folder",
  "newFileFolderPath": "documentacion"
}
